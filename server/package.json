{
  "name": "stockwise-server",
  "version": "1.0.0",
  "description": "StockWise AI Server - Smart Inventory & Sales Management (PostgreSQL + Prisma)",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "test": "npm run test:unit",
    "test:unit": "jest --runInBand tests/safety.test.js tests/groq.test.js tests/seedSafety.test.js tests/googleAuth.test.js tests/signup.test.js tests/historySearch.test.js tests/users.test.js tests/workspaces.test.js tests/categories.test.js",
    "test:integration": "jest --detectOpenHandles --runInBand tests/api.test.js tests/workspaces.integration.test.js",
    "test:prepare": "node scripts/prepareTestDatabase.js",
    "demo:prepare": "node scripts/prepareDemo.js",
    "admin:prepare": "node scripts/prepareSuperAdmin.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "prisma": "^5.22.0",
    "supertest": "^6.3.4"
  }
}
