NODE_ENV=development
PORT=5001
# Neon: use distinct development and test databases/branches, with SSL enabled.
DATABASE_URL="postgresql://USER:PASSWORD@DEV_ENDPOINT.neon.tech/neondb?sslmode=require"
# No local test connection for the single-database demo; CI provisions disposable PostgreSQL.
TEST_DATABASE_URL=
JWT_SECRET=replace_with_32_plus_random_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
BCRYPT_ROUNDS=10

# Groq — server only. Leave key empty for honest unconfigured mode.
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER_TIMEOUT_MS=30000
CHAT_RATE_LIMIT_MAX=30

# Set true on the public portfolio deployment to disable business mutations.
DEMO_READ_ONLY=false
# Seeding is explicit, non-destructive by default, and never runs at startup.
SEED_FORCE=false
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=replace_with_unique_private_password

# Public demo uses a dedicated staff login; never share the owner login.
DEMO_LOGIN_EMAIL=visitor@stockwise.example
DEMO_LOGIN_PASSWORD=replace_with_unique_private_password

# Google Identity Services Web client ID (public ID; no client secret for this flow)
GOOGLE_CLIENT_ID=

# Owner access: provision once with npm run admin:prepare; keep credentials server-side.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
