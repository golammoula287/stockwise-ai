# Server Environment Configuration
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/stockwise?retryWrites=true&w=majority
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
BCRYPT_ROUNDS=10

# Optional Local Demo / Seed Flags (Never enable in production)
USE_IN_MEMORY_DB=false
AUTO_SEED=false
SEED_ADMIN_EMAIL=admin@stockwise.com
SEED_ADMIN_PASSWORD=change_me_before_seeding

# Client Environment Configuration
VITE_API_URL=http://localhost:5000/api
