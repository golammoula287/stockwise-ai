# Server Environment Configuration
PORT=5000
DATABASE_URL="postgresql://USER@HOST:5432/stockwise?schema=public"
TEST_DATABASE_URL="postgresql://USER@HOST:5432/stockwise_test?schema=public"
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
BCRYPT_ROUNDS=10

# AI Business Assistant Configuration (Server-Side Only — Never expose in client/.env)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base URL (defaults to https://api.openai.com/v1)
# Examples:
#   OpenAI: https://api.openai.com/v1
#   Groq:   https://api.groq.com/openai/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_TIMEOUT_MS=15000
CHAT_RATE_LIMIT_MAX=30

# Optional Seed Configuration (Never enable destructive seed in production)
SEED_ADMIN_EMAIL=admin@stockwise.com
SEED_ADMIN_PASSWORD=change_me_before_seeding

# Client Environment Configuration
VITE_API_URL=http://localhost:5000/api
