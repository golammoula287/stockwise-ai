# Reference only: put server values in server/.env, client values in client/.env.
NODE_ENV=development
PORT=5000
# Neon: use distinct development and test databases/branches, with SSL enabled.
DATABASE_URL="postgresql://USER:PASSWORD@DEV_ENDPOINT.neon.tech/neondb?sslmode=require"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST_ENDPOINT.neon.tech/neondb?sslmode=require"
JWT_SECRET=replace_with_32_plus_random_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
BCRYPT_ROUNDS=10

# xAI Grok — server only. Leave key empty for honest unconfigured mode.
AI_API_KEY=
AI_MODEL=grok-4.7
AI_BASE_URL=https://api.x.ai/v1
AI_PROVIDER_TIMEOUT_MS=30000
CHAT_RATE_LIMIT_MAX=30

# Set true on the public portfolio deployment to disable business mutations.
DEMO_READ_ONLY=false
# Seeding is explicit, non-destructive by default, and never runs at startup.
SEED_FORCE=false
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=replace_with_unique_private_password

# Client (public build variable)
VITE_API_URL=http://localhost:5000/api
